# Copy this file to .env and fill it in. .env is in .gitignore, so it never reaches GitHub.

# mock = read mock_users.json, no Microsoft account needed.
# graph = call Microsoft Graph for real (needs the three values below).
MODE=mock

# Only needed when MODE=graph. All three come from your Entra app registration.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
